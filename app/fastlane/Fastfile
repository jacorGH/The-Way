# The Way — build the iPhone app and send it to TestFlight, on GitHub's Mac (see .github/workflows/app-ios.yml).
# Signing is done by fastlane match: it makes the App Store certificate and profile once, keeps them encrypted in a
# private GitHub repository of yours, and reuses them on every build. No Mac or Keychain of your own is needed.
default_platform(:ios)

platform :ios do
  lane :beta do
    setup_ci
    app_id = ENV.fetch("APP_ID")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      duration: 1200
    )
    match(
      type: "appstore",
      app_identifier: app_id,
      api_key: api_key,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION"),
      readonly: false
    )
    profile = ENV.fetch("sigh_#{app_id}_appstore_profile-name")
    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["App"],
      bundle_identifier: app_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile
    )
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { app_id => profile } },
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER')} MARKETING_VERSION=#{ENV.fetch('APP_VERSION')}",
      output_directory: "build",
      output_name: "TheWay.ipa"
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
